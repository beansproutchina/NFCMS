#!/bin/sh
# Commit gate. Install with: git config core.hooksPath scripts/git-hooks
# (frontend/package.json's `prepare` script does this on `npm install`.)
#
# Bypass with `git commit --no-verify` — that is git's own escape hatch and deliberately left open.
# The gate's job is to make bypassing an explicit choice, not to be impossible to bypass. To accept a
# violation permanently, add it to frontend/scripts/lint-baseline.json instead: that file goes
# through review, a `--no-verify` does not.
set -e
ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

# ── backend ────────────────────────────────────────────────────────────────
# dyapi 3.2 起模块清单是构建期产物(`app/_scanFiles.js`),必须跟着源文件一起提交。
# 忘了重新生成的症状不是报错,而是**新加的 Model 静默不注册** —— 表不建、路由不挂,
# 到运行时才以「404 / 找不到模型」的形式冒出来。这里重生成一遍,不一致就拦。
if echo "$STAGED" | grep -q '^backend/'; then
  cd "$ROOT/backend"
  echo "→ dyapi 模块清单"
  npx dyapi scan app >/dev/null
  if ! git diff --quiet -- app/_scanFiles.js; then
    echo "✗ app/_scanFiles.js 与源文件不一致(已就地重新生成)。git add 它再提交。" >&2
    exit 1
  fi
  echo "→ backend tests"
  bun test
fi

# Nothing staged under frontend/ → nothing the rest of this gate can say anything about.
if ! echo "$STAGED" | grep -q '^frontend/'; then
  exit 0
fi

cd "$ROOT/frontend"

echo "→ design-system rules"
node scripts/lint-admin.mjs

echo "→ types"
npx vue-tsc --noEmit -p tsconfig.app.json --noCheck false

# `vue-tsc` is not enough on its own: it accepted a malformed `<Checkbox … //>` and a duplicate
# `:class` that only the Vue template compiler rejects, so the build is a separate gate, not a
# duplicate of the type check.
echo "→ build"
npm run build --silent >/dev/null

echo "→ frontend tests"
npm test --silent

echo "✓ gate passed"
