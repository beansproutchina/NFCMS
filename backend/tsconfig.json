{
    "compilerOptions": {
        "experimentalDecorators": true,
        "strict": false,
        "noImplicitAny": false,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "target": "es2024",
        "moduleResolution": "nodenext",
        "module": "nodenext",
        "types": ["node"],
        "allowSyntheticDefaultImports": true,
        "outDir": "./dist"
    }
}