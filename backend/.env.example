# Copy to .env and set strong random values. .env is gitignored.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-value
PASSWORD_SALT=change-me-to-a-strong-random-value
SITE_URL=https://your-domain.example

# DB_DRIVER=sqlite (default) | mysql (needs MYSQL_HOST/PORT/USER/PASSWORD/DATABASE)
DB_DRIVER=sqlite

# ── 公开站预渲染(SSG)────────────────────────────────────────────────────
# SSG_ENABLED=0            整体关掉(开发时不想每次保存都拉浏览器)
# SSG_BASE_URL=http://127.0.0.1        生成器访问哪个站点(容器内是同容器 nginx)
# SSG_CHROMIUM_PATH=/usr/bin/chromium  浏览器二进制。镜像里由 apk add chromium 提供;
#                                      macOS 开发可指向 "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# SSG_SPA_DIST=../frontend/dist        读 ssg-routes.json 与算构建指纹用
# SSG_DIR=                             产物目录,默认 backend/static/ssg
# SSG_DEBOUNCE_MS=400                  同一页面重复入队的合并窗口
# SSG_WATCH_MS=60000       盯构建指纹的间隔;0 关闭。前端重新构建后静态页会指向已删除的
#                          bundle(页面看着正常但一行 JS 都不跑),靠它自动重生成。
