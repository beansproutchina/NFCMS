# Copy to .env and set strong random values. .env is gitignored.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-value
PASSWORD_SALT=change-me-to-a-strong-random-value
SITE_URL=https://your-domain.example

# DB_DRIVER=sqlite (default) | mysql (needs MYSQL_HOST/PORT/USER/PASSWORD/DATABASE)
DB_DRIVER=sqlite
