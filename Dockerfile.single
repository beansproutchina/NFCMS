# syntax=docker/dockerfile:1

FROM node:24.10.0-alpine AS frontend-builder
ARG THEME=pear
WORKDIR /app/frontend

RUN npm config set registry https://registry.npmmirror.com

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./
COPY frontend_themes/${THEME}/ ./src/views/front/templates/

RUN npm run build


FROM node:24.10.0-alpine AS backend-deps
WORKDIR /app/backend

RUN npm config set registry https://registry.npmmirror.com

COPY backend/package*.json ./
# dyapi 在 package.json 里是 file:../../dyapi3/dyapi —— 相对 /app/backend 就是 /dyapi3/dyapi。
# 它在仓库外面,构建上下文看不到,而 npm 对不存在的 file: 路径**不报错**:建一条断链、退出 0,
# 直到运行时才炸 "Cannot find module 'dyapi/core/dyapiApp.js'"。pack.js 会把框架快照到
# vendor/dyapi/,这里放到对应位置即可,package.json 不用改。
COPY vendor/dyapi/ /dyapi3/dyapi/
# --install-links:把 file: 依赖装成真实目录而不是软链,否则下面跨 stage COPY node_modules
# 拷过去的还是一条断链。
# --omit=dev:运行时不需要 @types/bun 与 dyapi-cli。后者是 file:../../dyapi3/dyapi-cli,
# 构建上下文里根本不存在,装进来只会多一条断链。
RUN npm install --omit=dev --install-links
# 把上面那种静默失败变成构建期失败
RUN test -f node_modules/dyapi/package.json && test ! -L node_modules/dyapi \
    || (echo "!! dyapi 没被正确安装(断链或缺失),检查 vendor/dyapi 是否随包" && exit 1)


FROM oven/bun:1.3.13-alpine AS runtime
WORKDIR /app

# chromium 是预渲染器的运行时依赖(见 backend/app/services/BrowserPool.ts)。
# 用 apk 的包而不是 playwright 下载的二进制:后者不支持 musl,而且**构建期联网下载**在
# 信创离线内网里根本走不通。字体包不能省 —— 没有它 headless chromium 渲染中文是方块,
# 快照因此变成一张"看起来正常但全是豆腐块"的页面。
RUN apk add --no-cache nginx supervisor \
    chromium nss freetype harfbuzz ca-certificates \
    font-noto font-noto-cjk font-noto-emoji
ENV SSG_CHROMIUM_PATH=/usr/bin/chromium-browser \
    SSG_BASE_URL=http://127.0.0.1 \
    SSG_SPA_DIST=/usr/share/nginx/html

COPY backend/ ./backend/
COPY --from=backend-deps /app/backend/node_modules ./backend/node_modules

# dyapi 3.2 起模块清单由构建期生成(运行时扫目录在打包/分发场景下走不通),`app/_scanFiles.js`
# 因此是**提交进仓库的产物**。这里只断言它在场 —— 少了它容器起来就是一句
# 「找不到模块清单」。清单是否**陈旧**由 pre-commit 把关(那里才有 dyapi-cli)。
RUN test -f /app/backend/app/_scanFiles.js \
    || (echo "!! backend/app/_scanFiles.js 缺失,先在 backend/ 跑 npm run scan 并提交" && exit 1)

COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx.single.conf /etc/nginx/nginx.conf
COPY docker/supervisord.single.conf /etc/supervisord.conf

RUN mkdir -p /app/backend/data /app/backend/static/uploads /app/backend/upload

EXPOSE 80

CMD ["supervisord", "-c", "/etc/supervisord.conf"]
