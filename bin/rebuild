#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${YELLOW}=== NFCMS Docker Compose Rebuild ===${NC}"

# Check if docker-compose is available
if ! command -v docker-compose &> /dev/null && ! command -v docker &> /dev/null; then
    echo -e "${RED}Error: docker-compose or docker is not installed${NC}"
    exit 1
fi

# Try docker compose (new syntax) first, fallback to docker-compose
if command -v docker &> /dev/null && docker compose version &> /dev/null; then
    COMPOSE_CMD="docker compose"
    echo -e "${GREEN}Using: docker compose${NC}"
elif command -v docker-compose &> /dev/null; then
    COMPOSE_CMD="docker-compose"
    echo -e "${GREEN}Using: docker-compose${NC}"
else
    echo -e "${RED}Error: docker compose is not available${NC}"
    exit 1
fi

# Stop existing containers
echo -e "${YELLOW}Stopping existing containers...${NC}"
$COMPOSE_CMD down
if [ $? -ne 0 ]; then
    echo -e "${RED}Failed to stop containers${NC}"
    exit 1
fi

# Remove old images (optional, ask user)
read -p "$(echo -e ${YELLOW})Remove old images? (y/n)$(echo -e ${NC}) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}Removing old images...${NC}"
    $COMPOSE_CMD down --rmi all
fi

# Rebuild images
echo -e "${YELLOW}Building images...${NC}"
$COMPOSE_CMD build --no-cache

if [ $? -ne 0 ]; then
    echo -e "${RED}Failed to build images${NC}"
    exit 1
fi

echo -e "${GREEN}Images built successfully${NC}"

# Start containers
echo -e "${YELLOW}Starting containers...${NC}"
$COMPOSE_CMD up -d

if [ $? -eq 0 ]; then
    echo ""
    echo -e "${GREEN}=== Rebuild completed successfully ===${NC}"
    echo ""
    echo -e "${GREEN}Service Status:${NC}"
    $COMPOSE_CMD ps
    echo ""
    echo -e "${GREEN}Access URLs:${NC}"
    echo -e "  Frontend: ${GREEN}http://localhost${NC}"
    echo -e "  API: ${GREEN}http://localhost/api${NC}"
    echo ""
    echo -e "${YELLOW}View logs:${NC}"
    echo "  Backend: $COMPOSE_CMD logs -f backend"
    echo "  Frontend: $COMPOSE_CMD logs -f frontend"
    echo "  All: $COMPOSE_CMD logs -f"
else
    echo -e "${RED}Failed to start containers${NC}"
    exit 1
fi
