#!/bin/bash

# NFCMS Docker 环境信息 - bin/info
# 显示当前配置和可用命令

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

clear

echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║  NFCMS Docker 环境信息        ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""

# 获取当前容器信息
echo -e "${CYAN}📦 当前运行的容器：${NC}"
CONTAINERS=$(docker compose ps 2>/dev/null | grep -E 'nfcms-(backend|frontend)' || echo "")

if [ -z "$CONTAINERS" ]; then
    echo -e "${YELLOW}  没有正在运行的容器${NC}"
    echo ""
    echo -e "${YELLOW}启动命令：${NC}"
    echo -e "  ${CYAN}./bin/start${NC}          # 生产环境"
    echo -e "  ${CYAN}docker compose -f docker-compose.dev.yml up -d${NC}  # 开发环境"
else
    echo "$CONTAINERS"
fi

echo ""
echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║  配置对比               ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""

echo -e "${CYAN}生产环境 (docker-compose.yml)${NC}"
echo -e "  ${GREEN}✓${NC} 最安全（源代码不暴露）"
echo -e "  ${GREEN}✓${NC} 最快（最少卷挂载）"
echo -e "  ${GREEN}✓${NC} 适合部署"
echo -e "  ${RED}✗${NC} 无热重载"
echo ""

echo -e "${CYAN}开发环境 (docker-compose.dev.yml)${NC}"
echo -e "  ${GREEN}✓${NC} 支持热重载（bun --hot）"
echo -e "  ${GREEN}✓${NC} 快速迭代"
echo -e "  ${GREEN}✓${NC} 适合开发"
echo -e "  ${YELLOW}※${NC} 源代码挂载在容器内"
echo ""

echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║  常用命令             ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""

echo -e "${CYAN}生产环境操作：${NC}"
echo "  ./bin/start      # 启动"
echo "  ./bin/stop       # 停止"
echo "  ./bin/rebuild    # 重建"
echo ""

echo -e "${CYAN}开发环境操作：${NC}"
echo "  docker compose -f docker-compose.dev.yml up -d     # 启动"
echo "  docker compose -f docker-compose.dev.yml down      # 停止"
echo "  docker compose -f docker-compose.dev.yml logs -f   # 查看日志"
echo ""

echo -e "${CYAN}日志查看：${NC}"
echo "  docker compose logs -f backend      # 生产环境后端日志"
echo "  docker compose -f docker-compose.dev.yml logs -f backend  # 开发环境后端日志"
echo ""

echo -e "${CYAN}容器操作：${NC}"
echo "  docker compose ps                                   # 查看容器"
echo "  docker compose exec backend /bin/sh                 # 进入后端"
echo "  docker compose exec frontend /bin/sh                # 进入前端"
echo ""

echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║  访问地址               ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""
echo -e "  ${GREEN}前端${NC} ............ http://localhost"
echo -e "  ${GREEN}API${NC} ............ http://localhost/api"
echo -e "  ${GREEN}后端直接访问${NC} .... http://localhost:3000"
echo ""

echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║  卷挂载策略              ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""

echo -e "${CYAN}两个环境都有：${NC}"
echo "  ✓ ./backend/data          → 数据持久化"
echo "  ✓ ./backend/static        → 静态资源"
echo "  ✓ ./upload                → 用户文件"
echo "  ✓ ./frontend_themes       → 动态主题切换"
echo ""

echo -e "${CYAN}仅开发环境有：${NC}"
echo "  ✓ ./backend/app           → 源代码热重载"
echo ""

echo -e "${YELLOW}提示：修改前端后需要 npm run build 并重新构建容器${NC}"
echo ""
