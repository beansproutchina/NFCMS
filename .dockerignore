# Git
.git
.gitignore
.gitattributes

# Dependencies —— 必须带 **,否则只挡住根目录那一份:frontend/node_modules 会被
# `COPY frontend/ ./` 拖进镜像(宿主机编译的原生二进制进 linux 容器 = 坏),
# vendor/dyapi/node_modules 同理。容器里的依赖一律在构建阶段重新装。
**/node_modules
bun.lockb
yarn.lock
package-lock.json

# Build outputs
dist
build
*.tsbuildinfo

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Environment —— 带 ** 才能挡住 backend/.env,否则开发密钥会被 COPY 进镜像;
# 容器里的密钥/数据库配置一律走 compose 的 environment(见 docker-compose*.yml)。
**/.env
**/.env.local
**/.env.*.local

# 部署实例配置(含明文密钥)
.deploy

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# CI/CD
.github
.gitlab-ci.yml
.circleci

# Tests
coverage
.nyc_output
test-results

# Temporary
tmp
temp
*.tmp

# Active-theme dev symlink — excluded so `COPY frontend/` doesn't drag a dangling symlink into
# the image; the Dockerfile then `COPY frontend_themes/${THEME}/` populates the slot fresh.
frontend/src/views/front/templates
